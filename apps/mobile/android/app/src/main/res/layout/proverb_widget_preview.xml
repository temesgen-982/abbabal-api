<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="አባባል"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻ አዲስ"
            android:textSize="11sp"
            android:textColor="@color/widget_primary" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@color/widget_divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="ከማርጦር ላይ ከወደቀ በል በትር ይሻመዳል"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/widget_foreground"
        android:lineSpacingMultiplier="1.35"
        android:gravity="center"
        android:maxLines="5"
        android:ellipsize="end" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A proverb about patience."
        android:textSize="13sp"
        android:textColor="@color/widget_muted_foreground"
        android:textStyle="italic"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_marginTop="6dp" />

</LinearLayout>