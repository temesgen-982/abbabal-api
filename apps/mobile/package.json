{
	"name": "@abbabal/mobile",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"db:bundle": "node scripts/bundle-db.mjs",
		"build": "node scripts/bundle-db.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"assets:generate": "capacitor-assets generate --android --assetPath ../../packages/shared/assets --iconBackgroundColor '#ffffff'",
		"i18n": "wuchale",
		"android:sync": "cap sync android",
		"android:run": "pnpm build && cap run android",
		"android:live": "cap run android --live-reload --port 5173 --forwardPorts 5173:5173",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.3.4",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@capacitor-community/sqlite": "^8.1.0",
		"@capacitor/android": "^8.3.4",
		"@capacitor/app": "^8.1.0",
		"@capacitor/core": "^8.3.4",
		"@capacitor/share": "^8.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@lucide/svelte": "^1.8.0",
		"@wuchale/svelte": "^0.20.5",
		"wuchale": "^0.25.6"
	}
}
